<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netcoreapp3.0</TargetFrameworks>
        <Description>Helper objects for running ASP.Net Core on Service Fabric.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cogito.AspNetCore" Version="2.0.35" />
        <PackageReference Include="Microsoft.ServiceFabric" Version="11.7.157" />
        <PackageReference Include="Microsoft.ServiceFabric.AspNetCore.Abstractions" Version="8.7.157" />
        <PackageReference Include="Microsoft.ServiceFabric.Data" Version="8.7.157" />
        <PackageReference Include="Microsoft.ServiceFabric.Data.Extensions" Version="8.7.157" />
        <PackageReference Include="Microsoft.ServiceFabric.Services" Version="8.7.157" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'netcoreapp3.0' ">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' != 'netcoreapp3.0' ">
        <PackageReference Include="Microsoft.AspNetCore.Hosting.Abstractions" Version="2.3.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cogito.ServiceFabric.Services\Cogito.ServiceFabric.Services.csproj" />
    </ItemGroup>

</Project>
